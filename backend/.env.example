
PORT=4000
CLIENT_URL=http://localhost:5173

# Sesiones: reemplazar por un secreto aleatorio seguro
JWT_SECRET=change-this-secret

# Neon: pega aquí la cadena de conexión PostgreSQL del proyecto
DATABASE_URL=

# Base de datos PostgreSQL local en Docker (se usa si DATABASE_URL está vacío)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=soporte_web
DB_USER=soporte_web
DB_PASSWORD=soporte_dev

# Administrador inicial (solo para configuración local)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Asistente de IA con Groq
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
